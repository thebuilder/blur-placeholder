<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TheBuilder.BlurPlaceholder</PackageId>
    <Product>Blur Placeholder</Product>
    <Title>Blur Placeholder</Title>
    <Version>0.1.0</Version>
    <Authors>Daniel Schmidt</Authors>
    <Description>Generate WebP, BlurHash, or ThumbHash placeholders for Umbraco Image media.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-cms;backoffice;image;placeholder;blurhash;thumbhash;webp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thebuilder/blur-placeholder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/blur-placeholder.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Initial Umbraco CMS 17 package release.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <BackofficeClientDirectory>$(MSBuildProjectDirectory)/Client</BackofficeClientDirectory>
    <BackofficeAssetsPattern>wwwroot/App_Plugins/TheBuilderBlurPlaceholder/**/*</BackofficeAssetsPattern>
    <BackofficeAssetsDirectory>$(MSBuildProjectDirectory)/wwwroot/App_Plugins/TheBuilderBlurPlaceholder</BackofficeAssetsDirectory>
    <BackofficeManifest>$(BackofficeAssetsDirectory)/umbraco-package.json</BackofficeManifest>
    <BackofficeEntryPoint>$(BackofficeAssetsDirectory)/the-builder-blur-placeholder.js</BackofficeEntryPoint>
  </PropertyGroup>


  <!-- Central package management - no versions -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Blurhash.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="MimeKit" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>


  <ItemGroup>
    <!-- Don't include the client source folder as part of the package. The built bundle is copied to wwwroot. -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/App_Plugins/TheBuilderBlurPlaceholder/**/*" />
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <Target Name="BuildBackofficeAssetsForPack"
          Condition="'$(_IsPacking)' == 'true' and '$(NoBuild)' != 'true'">
    <Exec Command="corepack pnpm build" WorkingDirectory="$(BackofficeClientDirectory)" />
  </Target>

  <Target Name="RefreshBackofficeStaticWebAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="BuildBackofficeAssetsForPack">
    <ItemGroup>
      <Content Include="$(BackofficeAssetsPattern)" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateBackofficeAssetsForPack"
          BeforeTargets="IncludeStaticWebAssetsPackItems"
          Condition="'$(_IsPacking)' == 'true'">
    <Error Condition="!Exists('$(BackofficeManifest)')"
           Text="Cannot pack TheBuilder.BlurPlaceholder because the backoffice manifest is missing. Build the client first." />
    <Error Condition="!Exists('$(BackofficeEntryPoint)')"
           Text="Cannot pack TheBuilder.BlurPlaceholder because the backoffice entry point is missing. Build the client first." />
  </Target>

</Project>

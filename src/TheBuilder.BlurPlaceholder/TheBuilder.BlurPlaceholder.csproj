<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TheBuilder.BlurPlaceholder</PackageId>
    <Product>TheBuilder.BlurPlaceholder</Product>
    <Title>TheBuilder.BlurPlaceholder</Title>
    <Version>0.1.0</Version>
    <Authors>TheBuilder</Authors>
    <Description>Generate WebP, BlurHash, or ThumbHash placeholders for Umbraco Image media.</Description>
    <PackageTags>umbraco;umbraco-cms;backoffice;image;placeholder;blurhash;thumbhash;webp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/thebuilder/blur-placeholder</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thebuilder/blur-placeholder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Initial Umbraco CMS 17 package release.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>


  <!-- Central package management - no versions -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Api.Common" />
    <PackageReference Include="Umbraco.Cms.Api.Management" />
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.Web.Website" />
    <PackageReference Include="Blurhash.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>


  <ItemGroup>
    <!-- Don't include the client source folder as part of the package. The built bundle is copied to wwwroot. -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="LICENSE" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <Content Include="wwwroot\**" Pack="true" PackagePath="wwwroot" />
  </ItemGroup>

</Project>

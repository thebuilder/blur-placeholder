<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions so extensions can align with the host Umbraco project's package versions -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Umbraco 17 and 18 run on .NET 10, Umbraco 19 on .NET 11 only, so each target framework gets its own range. -->
    <UmbracoVersion Condition="'$(UmbracoVersion)' == '' and '$(TargetFramework)' == 'net11.0'">[19.0.0-rc1,20.0.0)</UmbracoVersion>
    <UmbracoVersion Condition="'$(UmbracoVersion)' == ''">[17.1.0,19.0.0)</UmbracoVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- Umbraco API packages - Used by extension templates -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Website" Version="$(UmbracoVersion)" />
    <!-- Match the ImageSharp major each Umbraco line ships: 3.x up to Umbraco 18, 4.x from Umbraco 19. -->
    <PackageVersion Include="Blurhash.ImageSharp" Version="4.0.1" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" Condition="'$(TargetFramework)' != 'net11.0'" />
    <PackageVersion Include="Blurhash.ImageSharp" Version="4.1.1" Condition="'$(TargetFramework)' == 'net11.0'" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" Condition="'$(TargetFramework)' == 'net11.0'" />
    <!-- Security floors for dependencies inherited from the supported Umbraco range. -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>
</Project>

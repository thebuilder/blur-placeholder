---
// @ts-nocheck — Blume's React island types flag valid Astro attributes.
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { EcosystemSection, LandingRoot } from "@thebuilder/umbraco-docs/astro";

import "./_home/home.css";

import backofficeShot from "../content/screenshots/blur-placeholder-media.png";
import { blurPlaceholderPackage, ecosystemPackages } from "../umbraco-package";

const { config } = data;

const marketplaceUrl =
  "https://marketplace.umbraco.com/package/thebuilder.blurplaceholder";
const nugetUrl = "https://www.nuget.org/packages/TheBuilder.BlurPlaceholder";
const repoUrl = "https://github.com/thebuilder/blur-placeholder";
const installCommand = "dotnet add package TheBuilder.BlurPlaceholder";
const deliveryResponse = `{
  "name": "Alpine lake",
  "url": "/media/alpine-lake.jpg",
  "blurPlaceholder": "data:image/webp;base64,UklGR..."
}`;

const formats = [
  {
    name: "Tiny WebP",
    image: "/demos/generated/alpine-lake-webp.webp",
    detail: "Browser-ready data URL · no decoder required",
  },
  {
    name: "BlurHash",
    image: "/demos/generated/alpine-lake-blurhash.webp",
    detail: "Compact, configurable native hash",
  },
  {
    name: "ThumbHash",
    image: "/demos/generated/alpine-lake-thumbhash.webp",
    detail: "Aspect ratio, color, and alpha metadata",
  },
];

const features = [
  {
    title: "Generated on save",
    body: "Create the placeholder when an Image changes and store it with the media item. Public requests do no image processing.",
  },
  {
    title: "Backfilled safely",
    body: "Process existing images once per output configuration, with resumable maintenance and targeted retries for transient failures.",
  },
  {
    title: "Delivered as one string",
    body: "Opt into blurPlaceholder through the Delivery API and pass the default WebP value straight to your image component.",
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/og/index.png"
  page={{
    title: "Blur Placeholder for Umbraco",
    description:
      "Generate compact WebP, BlurHash, or ThumbHash placeholders once in Umbraco and deliver one simple string to your frontend.",
    route: "/",
  }}
>
  <LandingRoot class="home">
    <section class="hero">
      <div class="hero__glow" aria-hidden="true"></div>
      <div class="shell hero__inner">
        <img
          class="hero__mark reveal"
          src="/logo-mark.svg"
          width="72"
          height="72"
          alt="Blur Placeholder"
          style="--i: 0"
          decoding="async"
        />
        <h1 class="hero__title reveal" style="--i: 1">
          Better image loading, <span class="hero__accent">generated in Umbraco</span>.
        </h1>
        <p class="hero__lede reveal" style="--i: 2">
          Generate a tiny WebP, BlurHash, or ThumbHash when an Image changes.
          Store it once, expose one self-describing string, and keep image
          processing out of public requests.
        </p>
        <div class="hero__actions reveal" style="--i: 3">
          <a class="button button--primary" href="/quickstart">Get started</a>
          <a class="button button--secondary" href={repoUrl} rel="noopener">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.72 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.52.56.83 1.28.83 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"></path>
            </svg>
            View on GitHub
          </a>
        </div>
        <div class="install reveal" style="--i: 4">
          <span aria-hidden="true">$</span>
          <code>{installCommand}</code>
          <button type="button" data-copy={installCommand} aria-label="Copy install command">
            <svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg class="done-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="m20 6-11 11-5-5"></path>
            </svg>
          </button>
        </div>
        <p class="hero__compat reveal" style="--i: 5">For Umbraco CMS 17.1 and later</p>
      </div>
      <div class="shell">
        <figure class="screenshot screenshot--hero reveal" style="--i: 5">
          <div class="screenshot__bar" aria-hidden="true"><span></span><span></span><span></span></div>
          <img
            src={backofficeShot.src}
            width={backofficeShot.width}
            height={backofficeShot.height}
            alt="Blur Placeholder preview on an Image media item in the Umbraco backoffice"
            loading="eager"
            decoding="async"
          />
        </figure>
      </div>
    </section>

    <section class="shell trust reveal">
      <p><strong>Generated once, stored with the image.</strong> No image processing during public requests, no required browser decoder, and no separate placeholder service.</p>
    </section>

    <section class="shell showcase" aria-labelledby="showcase-title">
      <div class="section-heading reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2 id="showcase-title">One field, three representations</h2>
        <p>
          Choose the smallest frontend contract that fits your stack. The default
          WebP works anywhere an image URL works.
        </p>
      </div>
      <div class="format-grid">
        {formats.map((format, index) => (
          <article class="format-card reveal" style={`--i: ${index + 1}`}>
            <div class="format-card__image">
              <img src={format.image} alt={`${format.name} placeholder preview`} loading="lazy" />
            </div>
            <div>
              <h3>{format.name}</h3>
              <p>{format.detail}</p>
            </div>
          </article>
        ))}
      </div>
      <a class="text-link" href="/overview">
        Compare formats and payload sizes <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="shell feature-section" aria-labelledby="feature-title">
      <div class="section-heading reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2 id="feature-title">Built around the media lifecycle</h2>
        <p>
          Placeholder generation belongs next to the source image—not in every
          frontend that consumes it.
        </p>
      </div>
      <div class="feature-grid">
        {features.map((feature, index) => (
          <article class="feature-card reveal" style={`--i: ${index + 1}`}>
            <span class="feature-card__number" aria-hidden="true">0{index + 1}</span>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="shell backoffice">
      <div class="backoffice__copy reveal">
        <span class="rule" aria-hidden="true"></span>
        <h2>One frontend-ready field</h2>
        <p>
          Request <code>blurPlaceholder</code> explicitly through the Delivery API.
          The default WebP value can go straight into an image component, while
          native hashes remain self-describing when a server-side decoder is worth it.
        </p>
        <a class="button button--secondary" href="/delivery-api">Read the guide</a>
      </div>
      <figure class="code-preview reveal" style="--i: 1">
        <figcaption class="code-preview__bar">
          <span class="code-preview__dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>Delivery API response</span>
          <span class="code-preview__language">JSON</span>
        </figcaption>
        <pre tabindex="0"><code>{deliveryResponse}</code></pre>
      </figure>
    </section>

    <section class="shell closing reveal">
      <div class="closing__glow" aria-hidden="true"></div>
      <h2>Generate once. Deliver everywhere.</h2>
      <p>
        Install the package, save an image, and request the generated field only
        where your frontend needs it.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="/quickstart">Read the quickstart</a>
        <a class="button button--secondary" href={marketplaceUrl} rel="noopener">Umbraco Marketplace</a>
      </div>
    </section>

    <EcosystemSection
      packages={ecosystemPackages}
      currentPackageId={blurPlaceholderPackage.id}
    />
  </LandingRoot>

  <footer class="home-footer" slot="footer">
    <div class="shell home-footer__inner">
      <div>
        <strong>Blur Placeholder</strong>
        <span>MIT licensed · built by <a href="https://github.com/thebuilder" rel="noopener">thebuilder</a></span>
      </div>
      <nav aria-label="Footer">
        <a href="/overview">Docs</a>
        <a href={repoUrl} rel="noopener">GitHub</a>
        <a href={nugetUrl} rel="noopener">NuGet</a>
        <a href={marketplaceUrl} rel="noopener">Marketplace</a>
      </nav>
    </div>
  </footer>
</PageLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-udocs-root]");
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && !prefersReduced && "IntersectionObserver" in window) {
    root.classList.add("home--motion");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px", threshold: 0.1 },
    );
    for (const element of root.querySelectorAll(".reveal")) observer.observe(element);
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        button.classList.add("is-copied");
        window.setTimeout(() => button.classList.remove("is-copied"), 1600);
      } catch {
        // Clipboard access is optional; the command remains selectable.
      }
    });
  }
</script>
